# Copy to .env.local for local experiments. Never commit real values.

# Local API and control-plane settings
AIGUARD_DEMO=0
AIGUARD_TOKEN=
AIGUARD_API_KEY=
AIGUARD_ALLOWED_HOSTS=
AIGUARD_PROVIDERS=
AIGUARD_AUDIT_STDOUT=0

# Detection and request limits
AIGUARD_NER_ENGINE=thainer
AIGUARD_FINETUNED_MODEL_DIR=
AIGUARD_MAX_TEXT_CHARS=200000
AIGUARD_PDF_MAX_PAGES=100
AIGUARD_PDF_MAX_PAGE_POINTS=5000

# Provider credentials stay in the backend process only.
AIFORTHAI_API_KEY=
TOKENMIND_BASE_URL=
TOKENMIND_API_KEY=
TOKENMIND_ALLOW_HTTP=0

# Provisional local worker emulator; not the official hosted delivery path.
AIGUARD_QUEUE_POLL_URL=
AIGUARD_QUEUE_RESULT_URL=
AIGUARD_QUEUE_IDLE_S=2.0
AIGUARD_MAX_JOB_BYTES=
